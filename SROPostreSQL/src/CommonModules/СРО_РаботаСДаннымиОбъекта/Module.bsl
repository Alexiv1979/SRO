Функция ПроверкаНаУчетОшибки(ЛевоеЗначениеУсловия, ПравоеЗначениеУсловия, Коэфф, Условие4кв2025 = Ложь)
		
	ЛевоеЗначениеУсловияУмноженныйНаКоэфф = окр(ЛевоеЗначениеУсловия* Коэфф/100, 3); 
	Если Условие4кв2025 Тогда
		Условие = ЛевоеЗначениеУсловияУмноженныйНаКоэфф > ПравоеЗначениеУсловия И ЛевоеЗначениеУсловияУмноженныйНаКоэфф - ПравоеЗначениеУсловия > 1;
	Иначе
		Условие = Макс(ЛевоеЗначениеУсловияУмноженныйНаКоэфф, ПравоеЗначениеУсловия) - Мин(ЛевоеЗначениеУсловияУмноженныйНаКоэфф, ПравоеЗначениеУсловия) > 1;	
	КонецЕсли;     
	
	Возврат Условие;
КонецФункции


