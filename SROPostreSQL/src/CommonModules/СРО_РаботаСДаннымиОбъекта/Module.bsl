	СтруктураПараметров.Вставить("ТЗраздел5_6", ТЗраздел5_6);
	
	// Запрос для раздлелов 7 и 8		
	// добавляем строку для посик КПК и ДатаОкончания
	//ЗаполнитьКОлонкуДЛляПоиска(ТЗразделы7_8);    	
	СтруктураПараметров.Вставить("ТЗразделы6_7", ТЗразделы6_7); 
	
	// Запрос для раздлелов 9
	//ЗаполнитьКОлонкуДЛляПоиска(ТЗРаздел9);  	
	СтруктураПараметров.Вставить("ТЗРаздел9", ТЗРаздел9); 
	
	//// Раздел 10
	////ЗаполнитьКОлонкуДЛляПоиска(ТЗРаздел10);    	
	//СтруктураПараметров.Вставить("ТЗРаздел10", ТЗРаздел10);  
	//
	//// Запрос для раздлелов 6 графа 4
	////ЗаполнитьКОлонкуДЛляПоиска(ТЗРаздел6Графа4);   
	//СтруктураПараметров.Вставить("ТЗРаздел6Графа4", ТЗРаздел6Графа4);    
	
КонецПроцедуры

Процедура ПолучитьТаблицыРазделовДокументаОтчетности(СтруктураПараметров) Экспорт
	
	ОтчетностьСРО = Неопределено;	
	
	Если ТипЗнч(Структурапараметров) = Тип("Структура") Тогда   		
		Если СтруктураПараметров.Свойство("ОтчетностьСРО") Тогда
			
			Если ЗначениеЗаполнено(СтруктураПараметров.ОтчетностьСРО) тогда   			
				//	ДатаОконч = СтруктураПараметров.ОтчетностьСРО.ДатаОкончанияОтчетногоПериода;	
				ОтчетностьСРО = СтруктураПараметров.ОтчетностьСРО;
			КонецЕсли;
			
		КонецЕсли;			
	КонецЕсли;
	
	ВыбВидОтчета = СтруктураПараметров.ВидОтчета; //СтруктураПараметров.ВидОтчета; 
	
	Если Не СтруктураПараметров.Свойство("ДатаНачалаОтчета") Тогда
		ДатаНачалаОтчетногоПериода = СтруктураПараметров.ДатаНачалаОтчетногоПериода;  
	Иначе	
		ДатаНачалаОтчетногоПериода = СтруктураПараметров.ДатаНачалаОтчета;     	
	КонецЕсли;
	
	Если Не СтруктураПараметров.Свойство("ДатаОкончанияОтчета") Тогда
		ДатаОкончанияОтчетногоПериода = СтруктураПараметров.ДатаОкончанияОтчетногоПериода;  
	Иначе	
		ДатаОкончанияОтчетногоПериода = СтруктураПараметров.ДатаОкончанияОтчета;     	
	КонецЕсли;
	
	Если СтруктураПараметров.Свойство("СписокКПК") Тогда
		МассивКПК = СтруктураПараметров.СписокКПК.ВыгрузитьЗначения();
	ИНаче
		МассивКПК = СтруктураПараметров.МассивКПК;
	КонецЕсли;
	
	ЗапросПоПСК = Новый Запрос;
	МВТ = Новый МенеджерВременныхТаблиц;
	
	ЗапросПоПСК.МенеджерВременныхТаблиц = МВТ;
	ЗапросПоПСК.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗначенияПСК.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_ДокументПСК
	|ИЗ
	|	Документ.ЗначенияПСК КАК ЗначенияПСК
	|ГДЕ
	|	ЗначенияПСК.Проведен = ИСТИНА
	|	И ЗначенияПСК.ДатаОкончанияОтчетногоПериода >= &ДатаНачала
	|	И ЗначенияПСК.ДатаОкончанияОтчетногоПериода <= &ДатаОкончания
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗначенияПСКРазделыПСК.Раздел КАК Раздел,
	|	ЗначенияПСКРазделыПСК.ЗначениеПСК КАК ЗначениеПСК,
	|	ЗначенияПСКРазделыПСК.ПредельноеЗначениеПСК КАК ПредельноеЗначениеПСК,
	|	ВТ_ДокументПСК.Ссылка.ДатаОкончанияОтчетногоПериода КАК СсылкаДатаОкончанияОтчетногоПериода
	|ПОМЕСТИТЬ ВТ_ЗначенияПСК
	|ИЗ
	|	Документ.ЗначенияПСК.РазделыПСК КАК ЗначенияПСКРазделыПСК
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДокументПСК КАК ВТ_ДокументПСК
	|		ПО ЗначенияПСКРазделыПСК.Ссылка = ВТ_ДокументПСК.Ссылка
	|ГДЕ
	|	ЗначенияПСКРазделыПСК.ЗначениеПСК > 0
	|	И ЗначенияПСКРазделыПСК.Ссылка.Проведен = ИСТИНА"; 
	
	Если ВыбВидОтчета = 0 Тогда		
		НачалоПериода = НачалоКвартала(ДатаНачалаОтчетногоПериода);
		ОкончаниеПериода = КонецКвартала(ДатаОкончанияОтчетногоПериода);
		
		ЗапросПоПСК.УстановитьПараметр("ДатаНачала", НачалоПериода);
		ЗапросПоПСК.УстановитьПараметр("ДатаОкончания", ОкончаниеПериода);		
		КолДопКолонок = 0;
	Иначе
		НачалоПериода = НачалоМесяца(ДатаНачалаОтчетногоПериода);
		ОкончаниеПериода = КонецМесяца(ДатаОкончанияОтчетногоПериода);    
		
		ЗапросПоПСК.УстановитьПараметр("ДатаНачала", НачалоПериода);
		ЗапросПоПСК.УстановитьПараметр("ДатаОкончания", ОкончаниеПериода);	
		КолДопКолонок = 1;
	КонецЕсли;
	
	ЗапросПоПСК.УстановитьПараметр("Раздел6", Справочники.Разделы.Раздел6);
	
	
	ЗапросПоПСК.Выполнить();
	
	
	
	Если СтруктураПараметров.Свойство("ЗапросПоПСК") Тогда
		СтруктураПараметров.ЗапросПоПСК = ЗапросПоПСК;
	иначе
		СтруктураПараметров.Вставить("ЗапросПоПСК", ЗапросПоПСК);
	КонецЕсли;
	
	СтруктураПараметров.Вставить("МВТ", МВТ);
	
	СтруктураПараметров.Вставить("НачалоПериода", НачалоПериода);
	СтруктураПараметров.Вставить("ОкончаниеПериода", ОкончаниеПериода);
	
	
	//
	//+ВА
	// Добавил отбор по коду документа
	
	Запрос = Новый Запрос;
	Запрос.Текст = " 
	|ВЫБРАТЬ
	|	ОтчетностьКПК.КПК КАК КПК,
	|	ОтчетностьКПК.Ссылка КАК ДокументОтчетности
	|ПОМЕСТИТЬ ВременнаяТаблица
	|ИЗ
	|	Документ.ОтчетностьКПК КАК ОтчетностьКПК  
	|ГДЕ
	|	ОтчетностьКПК.ВидОтчета <> Значение(Перечисление.ВидыОтчетов.Годовой30Дней)
	|	И ОтчетностьКПК.ПометкаУдаления = ЛОЖЬ"; 
	
	МассивКодовДокумента = Новый Массив;
	МассивКодовДокумента.Добавить(Перечисления.КодДокумента.ОКУД_0420820_21633);
	МассивКодовДокумента.Добавить(Перечисления.КодДокумента.ОКУД_0420820_21634);	
	
	Если Не ЗначениеЗаполнено(ОтчетностьСРО) Тогда
		
		//	Если ТипЗнч(ОтчетностьСРО) = Тип("Массив") Тогда
		//		Запрос.Текст = Запрос.Текст + "
		//		|	ОтчетностьКПК.Ссылка В (&ОтчетностьСРО)";  
		//	Иначе
		//		
		//		Запрос.Текст = Запрос.Текст + "
		//		|	ОтчетностьКПК.Ссылка  = &ОтчетностьСРО";  			
		//	КонецЕсли;
		//	
		//Иначе	
		
		
		Если НачалоДня(ОкончаниеПериода) < Дата(2020, 6, 30) Тогда
			Запрос.УстановитьПараметр("МассивКодовДокумента", МассивКодовДокумента);
			Запрос.Текст = Запрос.Текст + " 
			|	И Не ОтчетностьКПК.КодДокумента В (&МассивКодовДокумента)";
		КонецЕсли;
	КонецЕсли;
	
	
	Запрос.Текст = Запрос.Текст + " 		
	|	И ОтчетностьКПК.ТипДокумента В (&МассивТиповДокументов)       	
	|	#Отбор#     
	|	
	|СГРУППИРОВАТЬ ПО
	|	ОтчетностьКПК.КПК,
	|	ОтчетностьКПК.Ссылка
	|;
	
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК КПК,
	|	ВременнаяТаблица.ДокументОтчетности КАК ДокументОтчетности,
	|	НЕ ВременнаяТаблица.КПК ЕСТЬ NULL КАК ЕстьДокумент	
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|		#СоединениеПоКПК# СОЕДИНЕНИЕ ВременнаяТаблица КАК ВременнаяТаблица	
	//|	ЛЕВОЕ СОЕДИНЕНИЕ ВременнаяТаблица КАК ВременнаяТаблица	
	|		ПО (ВременнаяТаблица.КПК = Контрагенты.Ссылка)
	
	|СГРУППИРОВАТЬ ПО
	|	Контрагенты.Ссылка,
	|	ВременнаяТаблица.ДокументОтчетности,
	|	НЕ ВременнаяТаблица.КПК ЕСТЬ NULL
	|;
	
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.КПК КАК КПК,
	|	ВТ.КПК.НомерВРеестреСРО КАК НомерВРеестреСРО,
	|	ВТ.ДокументОтчетности КАК ДокументОтчетности,
	|	ВТ.ЕстьДокумент КАК ЕстьДокумент,      
	|	ВТ.ДокументОтчетности.ДатаОкончанияОтчетногоПериода КАК ДатаОкончанияОтчетногоПериода,
	|	ЕстьNULL(ОтчетностьКПК.Ссылка, НЕОПРЕДЕЛЕНО) КАК ПредДокументОтчетности
	|
	|ИЗ
	|	ВТ КАК ВТ
	|	ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтчетностьКПК КАК ОтчетностьКПК
	|	ПО (ВТ.КПК = ОтчетностьКПК.КПК
	|				И ОтчетностьКПК.ПометкаУдаления = ЛОЖЬ";
	
	Если Не ЗначениеЗаполнено(ОтчетностьСРО) Тогда 
		Если НачалоДня(ОкончаниеПериода) < Дата(2020, 6, 30) Тогда
			Запрос.Текст = Запрос.Текст + " 
			|			И Не ОтчетностьКПК.КодДокумента В (&МассивКодовДокумента)";
		КонецЕсли;
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + "
	|				И ОтчетностьКПК.ТипДокумента В (&МассивТиповДокументов) 
	|				И ОтчетностьКПК.ВидОтчета <> ЗНАЧЕНИЕ(Перечисление.ВидыОтчетов.Годовой30Дней)
	|				И (ОтчетностьКПК.ДатаОкончанияОтчетногоПериода МЕЖДУ НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(ВТ.ДокументОтчетности.ДатаОкончанияОтчетногоПериода, МЕСЯЦ, -3), КВАРТАЛ) И КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(ВТ.ДокументОтчетности.ДатаОкончанияОтчетногоПериода, МЕСЯЦ, -3), КВАРТАЛ))
	|				И (ОтчетностьКПК.ИспользоватьДокумент = ИСТИНА
	|			И ОтчетностьКПК.ПредварительнаяПроверка = ЛОЖЬ))
	|
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.КПК,
	|	ВТ.КПК.НомерВРеестреСРО,
	|	ВТ.ДокументОтчетности,
	|	ВТ.ЕстьДокумент,        
	|	ВТ.ДокументОтчетности.ДатаОкончанияОтчетногоПериода,
	|	ОтчетностьКПК.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерВРеестреСРО,
	|	ДатаОкончанияОтчетногоПериода
	|ИТОГИ
	|ПО
	|	КПК,
	|	ДатаОкончанияОтчетногоПериода";   	
	
	ОтборПоКПК = "";		
	
	Запрос.УстановитьПараметр("МассивКодовДокумента", МассивКодовДокумента);
	
	//+ВА
	МассивТиповДокументов = Новый Массив;
	МассивТиповДокументов.Добавить(Перечисления.ТипДокумента.ПустаяСсылка());
	МассивТиповДокументов.Добавить(Перечисления.ТипДокумента.ОтчетОДеятельностиКооператива);
	
	Запрос.УстановитьПараметр("МассивТиповДокументов", МассивТиповДокументов);
	
	//-ВА
	
	Если ОтчетностьСРО <> Неопределено Тогда
		
		Если ТипЗнч(ОтчетностьСРО) = Тип("Массив") Тогда  
			ОтборПоКПК = "И ОтчетностьКПК.Ссылка В (&ДокументОтчетности)";  
		Иначе    			
			ОтборПоКПК = "И ОтчетностьКПК.Ссылка  = &ДокументОтчетности";  			
		КонецЕсли;
		
		СоединениеПоКПК = "ВНУТРЕННЕЕ";   
		Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаОкончанияОтчетногоПериода));
		Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончанияОтчетногоПериода));
		
		Запрос.УстановитьПараметр("ДокументОтчетности", ОтчетностьСРО);	    
	Иначе
		
		СоединениеПоКПК = "ЛЕВОЕ";
		
		Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачалаОтчетногоПериода));
		Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончанияОтчетногоПериода));	
		
		
		Если ВыбВидОтчета = 0 Тогда		
			
			//Запрос.УстановитьПараметр("ДатаНачала", ДатаОкончанияОтчетногоПериода);
			//Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончанияОтчетногоПериода);	
		Иначе                                            		
			//Запрос.УстановитьПараметр("ДатаНачала", ДатаНачалаОтчетногоПериода);
			//Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончанияОтчетногоПериода);			
			
			Если МассивКПК.Количество() > 0 Тогда
				Запрос.УстановитьПараметр("МассивКПК", МассивКПК);	    
				
				ОтборПоКПК = "И ОтчетностьКПК.КПК В (&МассивКПК)";
				
			КонецЕсли;                         	
			
			СоединениеПоКПК = "ВНУТРЕННЕЕ";
		КонецЕсли;
		
		ОтборПоКПК = ОтборПоКПК + "	И ОтчетностьКПК.ДатаОкончанияОтчетногоПериода МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И (ОтчетностьКПК.ИспользоватьДокумент = ИСТИНА
		|	И ОтчетностьКПК.ПредварительнаяПроверка = ЛОЖЬ И &ОтборПоПредварительнаяПроверка = ЛОЖЬ Или ОтчетностьКПК.ПредварительнаяПроверка = ИСТИНА И  &ОтборПоПредварительнаяПроверка = Истина)";
	КонецЕсли;
	
	Если СтруктураПараметров.Свойство("ОтборПоПредварительнаяПроверка") Тогда
		ОтборПоПредварительнаяПроверка = СтруктураПараметров.ОтборПоПредварительнаяПроверка;
	Иначе
		ОтборПоПредварительнаяПроверка = Ложь;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ОтборПоПредварительнаяПроверка", ОтборПоПредварительнаяПроверка);	    
	
	
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#Отбор#", ОтборПоКПК);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#СоединениеПоКПК#", СоединениеПоКПК);
	
	
	РезультатЗапроса = Запрос.Выполнить(); 
	
	СтруктураПараметров.Вставить("РезультатЗапроса", РезультатЗапроса);
	
	// Вот здесь еще результат получаем по
	
	
	ТЗРаздел6Графа4 = Неопределено;
	ТЗраздел5_6 = Неопределено;  		
	ТЗразделы7_8 = Неопределено;
	ТЗРаздел9 = Неопределено;
	ТЗРаздел10 = Неопределено;
	
	//Справочники.Разделы.Раздел5);
	//СписокРазделов.Добавить(Справочники.Разделы.Раздел6);
	
	ЕстьДокументОтчетности = Ложь;
	ВыборкаПоКПК = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПоКПК.Следующий() Цикл
		ВыборкаДатаОкончания = ВыборкаПоКПК.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаДатаОкончания.Следующий() Цикл
			Выборка = ВыборкаДатаОкончания.Выбрать();
			Пока Выборка.Следующий() Цикл
				
				Если Не ЗначениеЗаполнено(Выборка.ДокументОтчетности) Тогда
					Продолжить;					
				КонецЕсли;
				
				ЕстьДокументОтчетности = Истина;
				
				// Разделы 6 графа 4									
				
				Если ТЗРаздел6Графа4 = Неопределено Тогда
					ТЗРаздел6Графа4 = ПолучитьТаблицуПоказателей6_Графа4(Выборка.ДокументОтчетности);
				Иначе	
					ВремТЗ = ПолучитьТаблицуПоказателей6_Графа4(Выборка.ДокументОтчетности);
					Для Каждого СтрокаТЗ ИЗ ВремТЗ Цикл
						НоваяСтрока = ТЗРаздел6Графа4.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЗ);
					КонецЦикла; 			
				КонецЕсли;
				
				
				// Разделы 5 b 6									
				
				Если ТЗраздел5_6 = Неопределено Тогда
					ТЗраздел5_6 = ПолучитьТаблицуПоказателей5_6(Выборка.ДокументОтчетности);
				Иначе	
					ВремТЗ = ПолучитьТаблицуПоказателей5_6(Выборка.ДокументОтчетности);
					Для Каждого СтрокаТЗ ИЗ ВремТЗ Цикл
