#Область ПрограммныйИнтерфейс

#Область ПроверкаОтчетности
Функция СформироватьТабличныйДокументОтчетности(СтруктураПараметров) Экспорт
	
	Если СтруктураПараметров.Свойство("ТаблицаНормативовРасшифровка") Тогда
		ТаблицаНормативовРасшифровка = СтруктураПараметров.ТаблицаНормативовРасшифровка;
	Иначе	
		ТаблицаНормативовРасшифровка = Неопределено;
	КонецЕсли; 
	
	ПолучитьТаблицыРазделовДокументаОтчетности(СтруктураПараметров);
	
	// параметры
	ВидОтчета = СтруктураПараметров.ВидОтчета;  	
	ТипОтчета = СтруктураПараметров.ТипОтчета;  
	
	ВыводитьТолькоКПКСОтчетностью = СтруктураПараметров.ВыводитьТолькоКПКСОтчетностью;
	
	Если СтруктураПараметров.Свойство("СписокКПК") Тогда    		
		МассивКПК = СтруктураПараметров.СписокКПК.ВыгрузитьЗначения();            
	Иначе	
		МассивКПК = СтруктураПараметров.МассивКПК;            
	КонецЕсли;
	
	ДатаНачалаОтчетногоПериода = СтруктураПараметров.ДатаНачалаОтчета;
	ДатаОкончанияОтчетногоПериода = СтруктураПараметров.ДатаОкончанияОтчета;
	
	ОтчетностьСРО = СтруктураПараметров.ОтчетностьСРО;
	
	ПредварительнаяПроверка = СтруктураПараметров.ПредварительнаяПроверка; 
	
	Если СтруктураПараметров.Свойство("ОтборПоПредварительнаяПроверка") Тогда
		ОтборПоПредварительнаяПроверка = СтруктураПараметров.ОтборПоПредварительнаяПроверка;
	Иначе	
		ОтборПоПредварительнаяПроверка = Ложь;
	КонецЕсли; 
	
	Если Не СтруктураПараметров.Свойство("МассивУправленияГУ") Тогда                    		
		МассивУправленияГУ = Новый Массив;	
	Иначе	 		
		МассивУправленияГУ = СтруктураПараметров.МассивУправленияГУ;    
	КонецЕсли; 
	
	Если Не СтруктураПараметров.Свойство("ВидОтбора_КПК_УправлениеГУ") Тогда                    		
		ВидОтбора_КПК_УправлениеГУ = "";		
	Иначе
		ВидОтбора_КПК_УправлениеГУ = СтруктураПараметров.ВидОтбора_КПК_УправлениеГУ;   		
	КонецЕсли; 
	
	
	ТекстОшибокПредварительнаяПроверка = СокрЛП(СтруктураПараметров.ТекстОшибокПредварительнаяПроверка); 
	
	ТекстОшибокПредварительнаяПроверка = "";
	
	ЗапросПоПСК = СтруктураПараметров.ЗапросПоПСК;
	МВТ = СтруктураПараметров.МВТ;
	
	НачалоПериода =  ДатаНачалаОтчетногоПериода;
	ОкончаниеПериода = ДатаОкончанияОтчетногоПериода;
	
	ЗапросПоПСК = СтруктураПараметров.ЗапросПоПСК;
	
	РезультатЗапроса = СтруктураПараметров.РезультатЗапроса;
	
	ТЗРаздел6Графа4 = СтруктураПараметров.ТЗРаздел6Графа4; 
	
	ТЗраздел5_6 = СтруктураПараметров.ТЗраздел5_6;
	
	ТЗразделы7_8 = СтруктураПараметров.ТЗразделы7_8; 
	
	ТЗРаздел9 = СтруктураПараметров.ТЗРаздел9; 
	
	
	ТЗРаздел10 = СтруктураПараметров.ТЗРаздел10; 	
	
	НеВыводим_ОКУД0420820 = Ложь;
	
	//Если НачалоГода(ДатаОкончанияОтчетногоПериода) = НачалоКвартала(ДатаОкончанияОтчетногоПериода) Тогда		
	//	// 1 квартала не выводим эту ппроверку
	//	НеВыводим_ОКУД0420820 = Истина;
	//КонецЕсли;
	
	Если СтруктураПараметров.Свойство("ТабличныйДокумент") Тогда
		ТабличныйДокумент = СтруктураПараметров.ТабличныйДокумент;	
	Иначе	
		ТабличныйДокумент = Новый ТабличныйДокумент;
	КонецЕсли;
	
	Если СтруктураПараметров.Свойство("РезультатНадзорныеСоотношения") Тогда
		РезультатНадзорныеСоотношения = СтруктураПараметров.РезультатНадзорныеСоотношения;	
	Иначе	
		РезультатНадзорныеСоотношения = Новый ТабличныйДокумент;
	КонецЕсли;
	
	Если СтруктураПараметров.Свойство("РезультатКС") Тогда
		РезультатКС = СтруктураПараметров.РезультатКС;	
	Иначе	
		РезультатКС = Новый ТабличныйДокумент;
	КонецЕсли;
	
	Если СтруктураПараметров.Свойство("РезультатНормативы") Тогда
		РезультатНормативы = СтруктураПараметров.РезультатНормативы;	
	Иначе	
		РезультатНормативы = Новый ТабличныйДокумент;
	КонецЕсли;
	
	Если ТипОтчета = Перечисления.ТипыОчетаПроверки.СводныйОтчет Тогда		
		Макет = ПолучитьОбщийМакет("СРО_СводныйОтчетОРезультатахПроверки");    	
		//ТабличныйДокумент = Новый ТабличныйДокумент;  		
		
		ОбластьШапка = Макет.получитьОбласть("Шапка");
		
		ОбластьШапка.Параметры.ДатаФормированияОтчета = ТекущаяДата();
		ОбластьШапка.Параметры.КраткоеНазваниеСРО = СокрЛП(Константы.ОсновнаяОрганизация.Получить().Наименование);
		
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		ОбластьСтрока = Макет.получитьОбласть("Строка");       		
		
	ИначеЕсли ТипОтчета = Перечисления.ТипыОчетаПроверки.ПоРазделам Тогда
		
		Если ВидОтчета = 0 Тогда
			МакетНС = ПолучитьОбщийМакет("СРО_МакетКонтрольныеСоотношения_4кв2018");
		Иначе	
			МакетНС = ПолучитьОбщийМакет("СРО_МакетКонтрольныеСоотношения_4кв2018Период");
		КонецЕсли;
		
		Если ВидОтчета = 0 Тогда
			МакетКС = ПолучитьОбщийМакет("СРО_МакетКС_4кв2018");
			
		Иначе
			МакетКС = ПолучитьОбщийМакет("СРО_МакетКС_4кв2018Период");		
		КонецЕсли; 		
		
		
		// НС
		//РезультатНадзорныеСоотношения = Новый ТабличныйДокумент;
		
		Если СтруктураПараметров.ВыводимШапкуТаблиц Тогда
			ОбластьШапка = МакетНС.получитьОбласть("Шапка");
			
			ОбластьШапка.Параметры.ПредставлениеПериода = ПредставлениеПериода(НачалоПериода, ОкончаниеПериода);
			РезультатНадзорныеСоотношения.Вывести(ОбластьШапка);
			
			// КС
			//РезультатКС = Новый ТабличныйДокумент;
			
			ОбластьШапка = МакетКС.получитьОбласть("Шапка|Основная");
			
			ОбластьШапка.Параметры.ПредставлениеПериода = ПредставлениеПериода(НачалоПериода, ОкончаниеПериода);
			РезультатКС.Вывести(ОбластьШапка);
			
			Если Не НеВыводим_ОКУД0420820 Тогда		
				ОбластьШапка_Форма_ОКУД0420820 = МакетКС.получитьОбласть("Шапка|Форма_ОКУД0420820");	
				РезультатКС.Присоединить(ОбластьШапка_Форма_ОКУД0420820);                           
			КонецЕсли;       	
			
			СтруктураПараметров.ВыводимШапкуТаблиц = Ложь;
		КонецЕсли;
		
		ОбластьСтрокаКС = МакетКС.получитьОбласть("Строка|Основная"); 	
		ОбластьСтрокаКС_Форма_ОКУД0420820 = МакетКС.получитьОбласть("Строка|Форма_ОКУД0420820"); 	
		
		//РезультатНормативы = Новый ТабличныйДокумент;
		
		
		
		// 4. Нормативы
		
		ИспользоватьНовуюФормуНормативов = Истина;
		
		Если ИспользоватьНовуюФормуНормативов = Истина Тогда
			Если ВидОтчета = 0 Тогда
				//МакетНормативы = ПолучитьОбщийМакет("СРО_МакетНормативы_4кв2018");
				МакетНормативы = ПолучитьОбщийМакет("СРО_МакетНормативы_4кв2018Новый");
			Иначе
				МакетНормативы = ПолучитьОбщийМакет("СРО_МакетНормативы_4кв2018ПериодНовый");
			КонецЕсли;  	
			
			ТаблицаНормативов = Новый ТаблицаЗначений;
			ТаблицаНормативов.Колонки.Добавить("КПК", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
			ТаблицаНормативов.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
			ТаблицаНормативов.Колонки.Добавить("НомерВРеестреСРО", Новый ОписаниеТипов("Число")); 
			ТаблицаНормативов.Колонки.Добавить("ФН1Расчет", Новый ОписаниеТипов("Число"));
			ТаблицаНормативов.Колонки.Добавить("ФН2Расчет", Новый ОписаниеТипов("Число"));
			ТаблицаНормативов.Колонки.Добавить("ФН3Расчет", Новый ОписаниеТипов("Число"));
			ТаблицаНормативов.Колонки.Добавить("ФН4Расчет", Новый ОписаниеТипов("Число"));
			ТаблицаНормативов.Колонки.Добавить("ФН5Расчет", Новый ОписаниеТипов("Число"));
			ТаблицаНормативов.Колонки.Добавить("ФН6Расчет", Новый ОписаниеТипов("Число"));
			ТаблицаНормативов.Колонки.Добавить("ФН7Расчет", Новый ОписаниеТипов("Число"));
			ТаблицаНормативов.Колонки.Добавить("ФН8Расчет", Новый ОписаниеТипов("Число"));
			
			ТаблицаНормативов.Колонки.Добавить("ФН1ЕстьОшибка", Новый ОписаниеТипов("Булево"));
			ТаблицаНормативов.Колонки.Добавить("ФН2ЕстьОшибка", Новый ОписаниеТипов("Булево"));
			ТаблицаНормативов.Колонки.Добавить("ФН3ЕстьОшибка", Новый ОписаниеТипов("Булево"));
			ТаблицаНормативов.Колонки.Добавить("ФН4ЕстьОшибка", Новый ОписаниеТипов("Булево"));
			ТаблицаНормативов.Колонки.Добавить("ФН5ЕстьОшибка", Новый ОписаниеТипов("Булево"));
			ТаблицаНормативов.Колонки.Добавить("ФН6ЕстьОшибка", Новый ОписаниеТипов("Булево"));
			ТаблицаНормативов.Колонки.Добавить("ФН7ЕстьОшибка", Новый ОписаниеТипов("Булево"));
			ТаблицаНормативов.Колонки.Добавить("ФН8ЕстьОшибка", Новый ОписаниеТипов("Булево"));
			
			
			Если ТаблицаНормативовРасшифровка = Неопределено Тогда				
				
				Тип_НазваниеФН = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100));
				Тип_Числитель_Знаменатель = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(500));
				
				ТаблицаНормативовРасшифровка = Новый ТаблицаЗначений;
				ТаблицаНормативовРасшифровка.Колонки.Добавить("НомерВРеестреСРО", Новый ОписаниеТипов("Число")); 
				ТаблицаНормативовРасшифровка.Колонки.Добавить("КПК", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
				ТаблицаНормативовРасшифровка.Колонки.Добавить("НазваниеФН", Тип_НазваниеФН);  				
				ТаблицаНормативовРасшифровка.Колонки.Добавить("ПорядокСортировкиПоФН", Новый ОписаниеТипов("Число")); 
				ТаблицаНормативовРасшифровка.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
				ТаблицаНормативовРасшифровка.Колонки.Добавить("ФНРасчет", Новый ОписаниеТипов("Число"));				
				ТаблицаНормативовРасшифровка.Колонки.Добавить("ФНЧислитель", Тип_Числитель_Знаменатель);
				ТаблицаНормативовРасшифровка.Колонки.Добавить("ФНЗнаменатель", Тип_Числитель_Знаменатель);
				ТаблицаНормативовРасшифровка.Колонки.Добавить("ФНЕстьОшибка", Новый ОписаниеТипов("Булево"));
				ТаблицаНормативовРасшифровка.Колонки.Добавить("СтрокаПоиска", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100)));
				
				
				
				
			КонецЕсли;
			
		Иначе
			Если ВидОтчета = 0 Тогда
				МакетНормативы = ПолучитьОбщийМакет("СРО_МакетНормативы_4кв2018");
			Иначе
				МакетНормативы = ПолучитьОбщийМакет("СРО_МакетНормативы_4кв2018Период");
			КонецЕсли;  		
		КонецЕсли;  
		
		ОбластьШапкаПредставлениеПериода = МакетНормативы.получитьОбласть("ШапкаПредставлениеПериода");
		ОбластьШапкаТаблицы = МакетНормативы.ПолучитьОбласть("ШапкаТаблицы");
		ОбластьСтрокаНормативы = МакетНормативы.ПолучитьОбласть("Строка"); 
		
		НомерСтрокиНормативы = 0;
		НазваниеТаблицы = "Нормативы";
		Если СтруктураПараметров.ВыводимШапкуНормативов Тогда    		
			
			// Табличный документ  			
			РезультатНормативы.НачатьАвтогруппировкуСтрок(); 				
			
			ОбластьШапкаПредставлениеПериода.Параметры.ПредставлениеПериода = ПредставлениеПериода(СтруктураПараметров.ДатаНачалаПериода, СтруктураПараметров.ДатаОкончанияПериода);
			РезультатНормативы.Вывести(ОбластьШапкаПредставлениеПериода, 1);
			
			РезультатНормативы.Вывести(ОбластьШапкаТаблицы, 2); 	
			
			СтруктураПараметров.ВыводимШапкуНормативов = Ложь;  
			
		КонецЕсли;
		
	КонецЕсли; 	
	
	
	
	//	Если Не ПредварительнаяПроверка Тогда
	ТаблицаОшибок = СтруктураПараметров.ТаблицаОшибок;
	//	КонецЕсли;
	
	СтрокаРазделитель = Символы.ПС + "   ";  
	
	КолДопКолонок = 0;
	
	
	Цвет_ОшибкаВПоказателях = Новый Цвет(255, 203, 203);
	
	
	СтрокаЧетная = Ложь;
	
	НомерСтроки = 0;
	
	ВыборкаКПК =  РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаКПК.Следующий() Цикл
		
		
		ВыборкаДатаОкончанияОтчетногоПериода=  ВыборкаКПК.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаДатаОкончанияОтчетногоПериода.Следующий() Цикл  				
			Выборка =  ВыборкаДатаОкончанияОтчетногоПериода.Выбрать();
			
			Если ЗначениеЗаполнено(ВыборкаДатаОкончанияОтчетногоПериода.ДатаОкончанияОтчетногоПериода) = 0 Тогда
				Если ВыводитьТолькоКПКСОтчетностью Тогда
					Прервать;
				КонецЕсли;
			КонецЕсли;
			
			
			Пока Выборка.Следующий() Цикл
				НомерСтроки = НомерСтроки +1;
				
				Итого_КоличествоВыявленныхТриггеров = 0;
				ВсегоОшибок = 0;
				
				КПК = Выборка.КПК;
				
				ЕстьДокумент = ЗначениеЗаполнено(Выборка.ДокументОтчетности); 
				
				СтруктураЗначение  = Новый Структура;
				
				Если ЕстьДокумент Тогда  	
					
					Для Каждого СтрокаПараметры ИЗ Выборка.ДокументОтчетности.ТаблицаПоказателей Цикл
						Раздел = СтрокаПараметры.Раздел;
						Если Не ЗначениеЗаполнено(Раздел) Тогда
							Прервать;
						КонецЕсли;
						
						СтруктураЗначение.Вставить("Раздел" + Раздел.Код, СтрокаПараметры.Показатель1); 								
						
					КонецЦикла;  
					
					Если СтруктураЗначение.Количество() = 0 Тогда
						Сообщить("В документе " + СокрЛП(Выборка.ДокументОтчетности) + " на заполнены показатели"); 
						Продолжить;
					КонецЕсли;
					
					// добавляем те показатели, которых нет в документе - отчетность еще не доделана на новый формат
					
					Если Не СтруктураЗначение.Свойство("Раздел2_3_2_2") Тогда
						СтруктураЗначение.Вставить("Раздел2_3_2_2", 0);
					КонецЕсли;      
					
					Если Не СтруктураЗначение.Свойство("Раздел2_3_2_1") Тогда
						СтруктураЗначение.Вставить("Раздел2_3_2_1", 0);
					КонецЕсли;   
					
					Если Не СтруктураЗначение.Свойство("Раздел2_3_2_7") Тогда
						СтруктураЗначение.Вставить("Раздел2_3_2_7", 0);
					КонецЕсли;      
					
					Если Не СтруктураЗначение.Свойство("Раздел2_3_2_8") Тогда
						СтруктураЗначение.Вставить("Раздел2_3_2_8", 0);
					КонецЕсли;
					
					Если Не СтруктураЗначение.Свойство("Раздел4_14_2") Тогда
						СтруктураЗначение.Вставить("Раздел4_14_2", 0);
					КонецЕсли;
					
					Если Не СтруктураЗначение.Свойство("Раздел4_14_3") Тогда
						СтруктураЗначение.Вставить("Раздел4_14_3", 0);
